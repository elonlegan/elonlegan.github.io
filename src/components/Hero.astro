---
import Badge from '@/components/Badge.astro';
import LinkedInIcon from '@/components/icons/LinkedIn.astro';
import MailIcon from '@/components/icons/Mail.astro';
import SocialPill from '@/components/SocialPill.astro';
import DownloadIcon from '@/components/icons/Download.astro';
import YearsExperience from '@/components/YearsExperience.astro';
import type { Translations } from '@/i18n/utils';

interface Props {
	translations: Translations['hero'];
}

const { translations: t } = Astro.props;
---

<div>
	<div class='flex gap-4 mb-4'>
		<img
			class='rounded-full shadow-lg size-16 object-cover'
			src='/elonlegan.webp'
			alt='Angel Leon'
		/>
		<a
			href='https://linkedin.com/in/elonlegan'
			target='_blank'
			rel='noopener'
			class='flex items-center transition md:justify-center md:hover:scale-105'
		>
			<Badge>{t.badge}</Badge>
		</a>
	</div>
	<h1 class='text-4xl font-bold tracking-tight text-white sm:text-5xl'>
		{t.greeting}
	</h1>
	<p class='mt-6 text-xl text-gray-300 [&>strong]:text-yellow-200 [&>strong]:font-semibold'>
		{t.bio_pre_years} <strong><YearsExperience start='2021-05-01' /></strong>
		<Fragment set:html={t.bio_post_years} />
	</p>
	<nav class='flex flex-wrap gap-4 mt-8'>
		<SocialPill href='mailto:elonlegan@gmail.com'>
			<MailIcon class='size-4' />
			{t.cta_email}
		</SocialPill>
		<SocialPill href='https://linkedin.com/in/elonlegan'>
			<LinkedInIcon class='size-4' />
			{t.cta_linkedin}
		</SocialPill>
		<SocialPill
			href={t.resume_url}
			download={t.resume_url.split('/').pop()}
			aria-label='Download resume as PDF'
		>
			<DownloadIcon class='size-4' />
			{t.cta_resume}
		</SocialPill>
	</nav>
</div>
